# Render.com deployment
PUBLIC_URL=/ohif/
USE_HASH_ROUTER=false

# ##### For deploy to Render - production #####
#       use with 'yarn run build:nocache:prod'
#       .env.production is copied into .env during prebuild step
# #####

REACT_APP_API_BASE_URL=https://baines-webquiz-deploy.onrender.com
APP_CONFIG=config/webquizConfig.js
NODE_ENV=production
